# Copie este arquivo para ".env" SOMENTE se quiser mudar algum ajuste.
# Sem nenhuma variável, o app usa os arquivos que já vêm na pasta data/ e funciona normalmente.
# Nunca envie o arquivo .env para o GitHub (ele já está no .gitignore).

# --- dados -------------------------------------------------------------------
# Recorte real do MonitorAr (gerado por scripts/preparar_dados_monitorar.py)
# PAE_DADOS_MONITORAR=data/reais/monitorar_estacoes_proximas.csv.gz

# Pasta onde você salva os CSVs exportados do QUALAR (CETESB)
# PAE_PASTA_QUALAR=data/qualar

# Dataset fictício de demonstração (versão 1 do projeto)
# PAE_CSV_PATH=data/demonstracao/ambiental_heliopolis.csv

# --- banco de dados (opcional) -------------------------------------------------
# Conexão no formato SQLAlchemy. No Supabase: Project Settings > Database > Connection string.
# DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
# PAE_TABELA=registros_ambientais

# --- tratamento (valores padrão) -------------------------------------------------
# Maior lacuna, em horas seguidas, preenchida na versão "tratada"
# PAE_LIMITE_LACUNA_HORAS=4
# Multiplicador do IQR para sinalizar outliers
# PAE_FATOR_IQR=1.5
